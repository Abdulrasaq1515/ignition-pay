{
  "name": "stellar-address-kit",
  "version": "1.0.1",
  "description": "TypeScript implementation of the Stellar Address Kit",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && tsup src/index.ts --format cjs,esm --dts",
    "generate:types": "node scripts/generate-types.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{js,json,md}\""
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=10.0.0"
  },
  "devDependencies": {
    "@stellar-address-kit/spec": "file:../spec",
    "@stellar/stellar-sdk": "^17.4.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^8.56.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.6.2",
    "tsup": "^9.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
